def calculator(a, b, op):
    if op == '+':
        return a + b
    elif op == '-':
        return a - b
    elif op == '*':
        return a * b
    elif op == '/':
        if b == 0:
            return "Error: Division by zero"
        return a / b
    else:
        return "Error: Invalid operator"

# Test
print(calculator(10, 5, '+'))  # 15
print(calculator(10, 0, '/'))  # "Error: Division by zero"
